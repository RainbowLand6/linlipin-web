{
  "name": "linlipin-svelte-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/security-headers.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write src scripts vite.config.ts",
    "format:check": "prettier --check src scripts vite.config.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@sveltejs/kit": "3.2.0",
    "qrcode": "1.5.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "fake-indexeddb": "6.2.8",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
